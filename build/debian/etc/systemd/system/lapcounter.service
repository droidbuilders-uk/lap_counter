[Unit]
Description=Lap Counter Pro Service
After=network.target

[Service]
Type=simple
User=lapcounter
Group=lapcounter
WorkingDirectory=/opt/lapcounter
ExecStart=/opt/lapcounter/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
